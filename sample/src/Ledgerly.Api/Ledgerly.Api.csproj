  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ledgerly.ServiceDefaults\Ledgerly.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Ledgerly.Core\Ledgerly.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ledgerly.IntegrationTests" />
  </ItemGroup>
</Project>
